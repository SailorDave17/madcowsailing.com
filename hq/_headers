# Cloudflare Pages reads this from the OUTPUT directory, which for this project
# is the site root itself (output `.`, root directory `hq`). It is not served.
#
# Rule order matters: Pages applies every matching rule, and a later one wins on
# a repeated header name. Keep the broad rule first and the narrow ones after.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Everything under assets/ is cached for a year. `immutable` tells the browser
# not to revalidate at all - that is the half that actually removes the request,
# and it is also why a file replaced under its own name reaches nobody who
# already has it. Cloudflare's edge kept a replaced gallery.js through a deploy
# (#95), and a purge would not have reached a browser that held it.
#
# So a replaced file gets a new URL, and how depends on what it is:
#   - assets/shared/css/ and assets/shared/js/ (copied from shared/) keep their
#     filenames. Every page names them with ?v=<the first 10 hex digits of the
#     file's sha256>. After editing one, run `python tools/assetver.py`, which
#     rewrites every reference. The gate (tools/linkcheck.py) refuses a page
#     whose version does not match the file.
#   - fonts and images are not versioned: rename rather than overwrite. A font
#     is named both in each page's preload and in a url() in tokens.css, and
#     the two must match exactly or it is fetched twice. The resume is the one
#     exception, handled by its own rule at the bottom of this file.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML itself must not be cached for a year, or a deploy would not reach
# anyone who had already visited. This is the rule the one above would otherwise
# swallow if a page ever lived under assets/.
/
  Cache-Control: public, max-age=0, must-revalidate

# The resume is the one thing under assets/ that is REPLACED under its own
# filename rather than content-hashed or renamed - a new version of a resume is
# the same document, and the URL is what goes in an email signature. The rule
# above would give a visitor who fetched it once a year of a stale copy with no
# revalidation, which is the failure its own note warns about ("Rename rather
# than overwrite"). Renaming is the wrong half of that advice here, because the
# stable URL is the point. So: cache it, but make the browser ask.
#
# Narrow rule, placed last, per the ordering note at the top of this file.
/assets/david-alvarado-resume.pdf
  Cache-Control: public, max-age=3600, must-revalidate
