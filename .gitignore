# Dev tooling only — html-validate, per package.json. Nothing here is served.
node_modules/

# Python bytecode from tools/
__pycache__/
*.py[cod]

# Build output of the Cloudflare Pages copy step. Never edit these; edit shared/.
hq/assets/shared/
sailing/assets/shared/
photos/public/assets/shared/

# The photo site's local state: wrangler pages dev keeps its stand-in D1 and R2
# under .wrangler/, and .dev.vars holds local values for the site's secrets.
# .env holds the D1-scoped Cloudflare API token that wrangler reads from
# photos/.env to apply migrations (README, the photo site). None of these is
# ever committed; the real secrets live in Cloudflare only.
.wrangler/
.dev.vars
.env
.env.*

# Originals never go under the served photos tree. Straight off a phone they
# carry GPS, and Pages publishes whatever is committed here. Only photos.py's
# derivatives (NNN-*.avif, NNN-*.webp, NNN.mp4) may be staged; keep the
# originals outside the repo and point --src at them. On 2026-09-25 six
# GPS-tagged originals sat untracked in sailing/assets/photos/ one "stage all"
# away from going live, and nothing in the gate would have refused them.
sailing/assets/photos/*.*
sailing/assets/photos/*/*
!sailing/assets/photos/*/[0-9][0-9][0-9]-*.avif
!sailing/assets/photos/*/[0-9][0-9][0-9]-*.webp
!sailing/assets/photos/*/[0-9][0-9][0-9].mp4

# Local working drafts, never committed. The epic draft carries answers to owner
# decisions that are not public; the filed issues (#75 and #76-#86) are the record.
docs/drafts/epic-hq-taskr-highlight.md
docs/drafts/taskr-case-study.md

# Editor and OS noise
.DS_Store
Thumbs.db
.playwright-mcp/
