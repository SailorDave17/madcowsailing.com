{
  "id": "/share/",
  "name": "Mad Cow Sailing photos",
  "short_name": "Mad Cow photos",
  "description": "Send the team your regatta and practice photos.",
  "lang": "en",
  "start_url": "/share/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#EDF0F0",
  "theme_color": "#EDF0F0",
  "icons": [
    { "src": "/icons/any-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/any-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share/receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "photos", "accept": ["image/*"] }
      ]
    }
  }
}
